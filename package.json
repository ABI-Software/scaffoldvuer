{
  "name": "@abi-software/scaffoldvuer",
  "version": "2.1.1-demo.2",
  "license": "Apache-2.0",
  "engines": {
    "node": "^24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ABI-Software/scaffoldvuer.git"
  },
  "scripts": {
    "serve": "vite --host --force",
    "build-bundle": "vite build",
    "build-static": "vite build -c vite.static-build.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vuese-gen": "node vuese-generator.js",
    "vuese-watch": "node vuese-generator.js watch",
    "changelog": "auto-changelog -p --output CHANGELOG.md --template keepachangelog",
    "version": "npm run build-bundle;npm run changelog; git add CHANGELOG.md",
    "release:beta": "npm version prerelease --preid=beta; npm publish --tag beta",
    "release:major": "npm version major;  npm publish",
    "release:minor": "npm version minor; npm publish",
    "release:patch": "npm version patch;  npm publish",
    "docs:dev": "vitepress dev docs",
    "docs:watch": "concurrently \"npm run vuese-watch\" \"npm run docs:dev\"",
    "docs:build": "npm run vuese-gen; vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "type": "module",
  "main": "./dist/scaffoldvuer.umd.cjs",
  "module": "./dist/scaffoldvuer.js",
  "exports": {
    ".": {
      "import": "./dist/scaffoldvuer.js",
      "require": "./dist/scaffoldvuer.umd.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./src/*": "./src/*"
  },
  "files": [
    "dist/*",
    "src/*",
    "public/*",
    "*.json",
    "*.js"
  ],
  "dependencies": {
    "@abi-software/map-utilities": "^1.14.1-demo.0",
    "@abi-software/sparc-annotation": "^0.3.2",
    "@abi-software/svg-sprite": "1.4.0",
    "@element-plus/icons-vue": "^2.3.2",
    "core-js": "^3.50.0",
    "element-plus": "^2.14.5",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "simple-dropzone": "^0.8.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zincjs": "^3.0.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vuese/markdown-render": "^2.11.3",
    "auto-changelog": "^2.6.0",
    "babel-plugin-component": "^1.1.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "sass": "^1.103.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitepress": "^1.6.4",
    "vue-docgen-api": "^4.79.2"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@rollup/rollup-darwin-arm64": "4.63.0",
    "@rollup/rollup-linux-x64-gnu": "4.63.0",
    "@rollup/rollup-win32-x64-msvc": "4.63.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.21.5": true
  }
}
